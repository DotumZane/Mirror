Menu="Utilities"
Title="Mirror"
Icon="icon.png"
Tag="sync"
---
<?php
$plugin = "mirror";
$versionFile = "/usr/local/emhttp/plugins/$plugin/VERSION";
$configFile = "/boot/config/plugins/$plugin/config.json";
$pidFile = "/var/run/$plugin.pid";
$pairPidFile = "/var/run/$plugin-pairing.pid";
$logFile = "/var/log/$plugin.log";
$discoveryFile = "/boot/config/plugins/$plugin/discovered-peers.json";
$pendingInvitesFile = "/boot/config/plugins/$plugin/pending-invites.json";
$peerFile = "/boot/config/plugins/$plugin/peer.json";
$peersFile = "/boot/config/plugins/$plugin/peers.json";

$version = is_file($versionFile) ? trim(file_get_contents($versionFile)) : "unknown";
$installed = is_file("/usr/local/sbin/mirrorctl");
$running = is_file($pidFile) && posix_kill((int)trim(file_get_contents($pidFile)), 0);
$pairingRunning = is_file($pairPidFile) && posix_kill((int)trim(file_get_contents($pairPidFile)), 0);
$logTail = is_file($logFile) ? shell_exec("tail -n 160 " . escapeshellarg($logFile)) : "";

$defaultConfig = [
  "server_a" => ["name" => "server-a", "root" => "/mnt/user/mirror-test-a"],
  "server_b" => [
    "name" => "server-b",
    "type" => "local",
    "root" => "/mnt/user/mirror-test-b",
    "share" => "mirror-test-b",
    "host" => "",
    "user" => "root",
    "port" => 22,
  ],
  "node_role" => "master",
  "role_locked" => false,
  "state_db" => "/boot/config/plugins/mirror/mirror.sqlite3",
  "trash_root" => "/boot/config/plugins/mirror/trash",
  "authority" => "server_a_preferred",
  "delete_propagation" => false,
  "delete_behavior" => "restore_missing",
  "share_pairs" => [],
  "sync_interval" => 10,
];
$config = $defaultConfig;
if (is_file($configFile)) {
  $decoded = json_decode(file_get_contents($configFile), true);
  if (is_array($decoded)) {
    $config = array_replace_recursive($defaultConfig, $decoded);
  }
}

function mirror_value($value) {
  return htmlspecialchars((string)$value, ENT_QUOTES, "UTF-8");
}

function mirror_share_name_from_path($path) {
  $prefix = "/mnt/user/";
  if (strpos($path, $prefix) !== 0) {
    return "";
  }
  $rest = substr($path, strlen($prefix));
  return explode("/", $rest, 2)[0] ?? "";
}

function mirror_current_shares() {
  $shares = [];
  foreach (glob("/mnt/user/*", GLOB_ONLYDIR) ?: [] as $path) {
    $name = basename($path);
    if ($name === "" || $name[0] === ".") {
      continue;
    }
    $shares[] = $name;
  }
  natcasesort($shares);
  return array_values($shares);
}

function mirror_server_name() {
  $ident = "/boot/config/ident.cfg";
  if (is_file($ident)) {
    $contents = (string)file_get_contents($ident);
    if (preg_match('/^NAME="?(.*?)"?$/m', $contents, $matches)) {
      $name = trim($matches[1], "\" \t\r\n");
      if ($name !== "") {
        return $name;
      }
    }
  }
  return gethostname() ?: "unraid";
}

function mirror_age_label($timestamp) {
  $timestamp = (int)$timestamp;
  if ($timestamp <= 0) {
    return "unknown age";
  }
  $age = max(0, time() - $timestamp);
  if ($age < 60) {
    return $age . "s ago";
  }
  if ($age < 3600) {
    return floor($age / 60) . "m ago";
  }
  return floor($age / 3600) . "h ago";
}

function mirror_json_file($path, $default = []) {
  if (!is_file($path)) {
    return $default;
  }
  $decoded = json_decode(file_get_contents($path), true);
  return is_array($decoded) ? $decoded : $default;
}

function mirror_peer_list($peersFile, $peerFile) {
  $data = mirror_json_file($peersFile, ["peers" => []]);
  $peers = is_array($data["peers"] ?? null) ? $data["peers"] : [];
  if (!$peers) {
    $legacy = mirror_json_file($peerFile, []);
    if (!empty($legacy["host"])) {
      $id = (string)($legacy["id"] ?? substr(hash("sha256", "host:" . strtolower((string)$legacy["host"])), 0, 16));
      $legacy["id"] = $id;
      $peers[$id] = $legacy;
    }
  }
  foreach ($peers as $id => $peer) {
    if (!is_array($peer)) {
      unset($peers[$id]);
      continue;
    }
    $peer["id"] = (string)($peer["id"] ?? $id);
    $peer["host"] = trim((string)($peer["host"] ?? ""));
    $peer["name"] = (string)($peer["name"] ?? ($peer["host"] ?: "Mirror peer"));
    $peer["shares"] = is_array($peer["shares"] ?? null) ? array_values($peer["shares"]) : [];
    $peers[$peer["id"]] = $peer;
    if ($peer["id"] !== (string)$id) {
      unset($peers[$id]);
    }
  }
  return $peers;
}

function mirror_primary_ip() {
  $output = trim((string)shell_exec("ip -o -4 route get 1.1.1.1 2>/dev/null | awk '{for(i=1;i<=NF;i++) if (\$i==\"src\") {print \$(i+1); exit}}'"));
  if (filter_var($output, FILTER_VALIDATE_IP, FILTER_FLAG_IPV4)) {
    return $output;
  }
  $hostIp = gethostbyname(gethostname() ?: "");
  return filter_var($hostIp, FILTER_VALIDATE_IP, FILTER_FLAG_IPV4) ? $hostIp : "";
}

$mirrorTab = (string)($_GET["tab"] ?? "status");
if (!in_array($mirrorTab, ["status", "lan", "shares", "config", "log"], true)) {
  $mirrorTab = "status";
}

function mirror_tab_url($tab) {
  return "/Settings/Mirror?tab=" . rawurlencode((string)$tab);
}

function mirror_tab_class($tab, $activeTab) {
  return "mirror-tab" . ((string)$tab === (string)$activeTab ? " is-active" : "");
}

function mirror_state_path() {
  return "/boot/config/plugins/mirror/state.json";
}

function mirror_route_key($routeConfig) {
  $a = (string)($routeConfig["server_a"]["root"] ?? "");
  $b = (string)($routeConfig["server_b"]["root"] ?? "");
  $peer = (string)($routeConfig["server_b"]["peer_id"] ?? $routeConfig["server_b"]["host"] ?? "");
  return substr(hash("sha256", $a . "|" . $peer . "|" . $b), 0, 16);
}

function mirror_configured_routes($config) {
  $pairs = is_array($config["share_pairs"] ?? null) ? array_values($config["share_pairs"]) : [];
  if (!$pairs) {
    return [["key" => "__default", "config" => $config]];
  }
  $routes = [];
  foreach ($pairs as $pair) {
    if (!is_array($pair)) {
      continue;
    }
    $routeConfig = $config;
    $routeConfig["server_a"] = array_replace($config["server_a"] ?? [], is_array($pair["server_a"] ?? null) ? $pair["server_a"] : []);
    $routeConfig["server_b"] = array_replace($config["server_b"] ?? [], is_array($pair["server_b"] ?? null) ? $pair["server_b"] : []);
    if (isset($pair["authority"])) {
      $routeConfig["authority"] = $pair["authority"];
    }
    if (isset($pair["delete_behavior"])) {
      $routeConfig["delete_behavior"] = $pair["delete_behavior"];
      $routeConfig["delete_propagation"] = $pair["delete_behavior"] === "mirror_deletes";
    }
    if (isset($pair["name"])) {
      $routeConfig["name"] = $pair["name"];
    }
    $routeConfig["paused"] = !empty($pair["paused"]);
    $routes[] = ["key" => mirror_route_key($routeConfig), "config" => $routeConfig];
  }
  return $routes ?: [["key" => "__default", "config" => $config]];
}

function mirror_route_label($routeConfig) {
  $name = trim((string)($routeConfig["name"] ?? ""));
  if ($name !== "") {
    return $name;
  }
  $a = mirror_share_name_from_path((string)($routeConfig["server_a"]["root"] ?? ""));
  $b = (string)($routeConfig["server_b"]["share"] ?? mirror_share_name_from_path((string)($routeConfig["server_b"]["root"] ?? "")));
  $peer = (string)($routeConfig["server_b"]["name"] ?? "");
  if ($a === "" && $b === "") {
    return "Unconfigured route";
  }
  $target = $b !== "" ? $b : "Other share";
  if (($routeConfig["server_b"]["type"] ?? "local") === "remote" && $peer !== "") {
    $target = $peer . " / " . $target;
  }
  return ($a !== "" ? $a : "This server") . " -> " . $target;
}

function mirror_route_state($allState, $routeKey) {
  if ($routeKey === "__default") {
    return [
      "files" => is_array($allState["files"] ?? null) ? $allState["files"] : [],
      "conflicts" => is_array($allState["conflicts"] ?? null) ? $allState["conflicts"] : [],
      "_meta" => is_array($allState["_meta"] ?? null) ? $allState["_meta"] : [],
    ];
  }
  $routeState = is_array($allState["pairs"][$routeKey] ?? null) ? $allState["pairs"][$routeKey] : [];
  return [
    "files" => is_array($routeState["files"] ?? null) ? $routeState["files"] : [],
    "conflicts" => is_array($routeState["conflicts"] ?? null) ? $routeState["conflicts"] : [],
    "_meta" => is_array($routeState["_meta"] ?? null) ? $routeState["_meta"] : [],
  ];
}

function mirror_route_summary($routeConfig, $routeState, $running) {
  if (!empty($routeConfig["paused"])) {
    return [
      "label" => mirror_route_label($routeConfig),
      "index" => "Paused",
      "status" => "Paused",
      "last_file" => "Route is paused",
      "last_status" => "paused",
      "upload_rate" => "Paused",
      "download_rate" => "Paused",
      "conflicts" => 0,
    ];
  }
  $files = is_array($routeState["files"] ?? null) ? $routeState["files"] : [];
  $conflicts = is_array($routeState["conflicts"] ?? null) ? $routeState["conflicts"] : [];
  $meta = is_array($routeState["_meta"] ?? null) ? $routeState["_meta"] : [];
  $lastPath = "";
  $lastStatus = "";
  $lastUpdated = 0;
  foreach ($files as $path => $entry) {
    if (!is_array($entry)) {
      continue;
    }
    $updated = (int)($entry["updated_at"] ?? 0);
    if ($updated >= $lastUpdated) {
      $lastUpdated = $updated;
      $lastPath = (string)$path;
      $lastStatus = (string)($entry["status"] ?? "");
    }
  }
  $hasConflict = count($conflicts) > 0 || $lastStatus === "conflict";
  $indexedCount = count($files);
  $attentionCount = count($conflicts);
  foreach ($files as $entry) {
    if (is_array($entry) && (string)($entry["status"] ?? "") === "conflict") {
      $attentionCount++;
    }
  }
  $phase = (string)($meta["phase"] ?? "");
  $processed = max(0, (int)($meta["processed"] ?? 0));
  $total = max(0, (int)($meta["total"] ?? 0));
  $metaUpdated = (int)($meta["updated_at"] ?? 0);
  $progressPercent = $total > 0 ? min(100, (int)floor(($processed / $total) * 100)) : 0;
  $cleanCount = max(0, $indexedCount - $attentionCount);
  $completePercent = $indexedCount > 0 ? (int)floor(($cleanCount / $indexedCount) * 100) : 0;
  $indexStatus = count($files) > 0 ? count($files) . " indexed" : "No index yet";
  if ($lastUpdated > 0) {
    $indexStatus .= " - " . mirror_age_label($lastUpdated);
  } elseif ($metaUpdated > 0) {
    $indexStatus .= " - " . mirror_age_label($metaUpdated);
  }
  if ($hasConflict) {
    $mirrorStatus = $completePercent . "% complete - needs attention";
  } elseif ($phase === "peer_offline") {
    $indexStatus = "Peer offline";
    if ($metaUpdated > 0) {
      $indexStatus .= " - " . mirror_age_label($metaUpdated);
    }
    $mirrorStatus = "Waiting for remote responder";
  } elseif ($phase !== "" && $phase !== "complete" && $total > 0) {
    $indexStatus = "Indexing " . $processed . "/" . $total . " files";
    $mirrorStatus = $progressPercent . "% complete - " . str_replace("_", " ", $phase);
  } elseif ($phase !== "" && $phase !== "complete") {
    $indexStatus = "Scanning files";
    if ($metaUpdated > 0) {
      $indexStatus .= " - " . mirror_age_label($metaUpdated);
    }
    $mirrorStatus = "Counting files - " . str_replace("_", " ", $phase);
  } elseif (count($files) === 0) {
    $mirrorStatus = $running ? "Index pending - waiting for first pass" : "0% complete";
  } else {
    $mirrorStatus = $completePercent . "% complete";
    $mirrorStatus .= $running ? " - watching for changes" : " - daemon stopped";
  }
  return [
    "label" => mirror_route_label($routeConfig),
    "index" => $indexStatus,
    "status" => $mirrorStatus,
    "last_file" => $lastPath !== "" ? $lastPath : ((string)($meta["current_path"] ?? "") ?: "No indexed files yet"),
    "last_status" => $lastStatus !== "" ? $lastStatus : ($phase !== "" ? str_replace("_", " ", $phase) : "none"),
    "upload_rate" => "Idle",
    "download_rate" => "Idle",
    "conflicts" => count($conflicts),
  ];
}

$shares = mirror_current_shares();
$serverAShare = mirror_share_name_from_path($config["server_a"]["root"]);
$serverBShare = mirror_share_name_from_path($config["server_b"]["root"]);
$serverBType = $config["server_b"]["type"] ?? "local";
$deleteBehavior = $config["delete_behavior"] ?? (!empty($config["delete_propagation"]) ? "mirror_deletes" : "restore_missing");
$configuredSharePairs = is_array($config["share_pairs"] ?? null) ? array_values($config["share_pairs"]) : [];
$syncRouteRows = [];
foreach ($configuredSharePairs as $pair) {
  if (!is_array($pair)) {
    continue;
  }
  $pairAShare = (string)($pair["server_a"]["share"] ?? mirror_share_name_from_path((string)($pair["server_a"]["root"] ?? "")));
  $pairBShare = (string)($pair["server_b"]["share"] ?? mirror_share_name_from_path((string)($pair["server_b"]["root"] ?? "")));
  if ($pairAShare !== "" && $pairBShare !== "") {
    $pairAuthority = (string)($pair["authority"] ?? ($config["authority"] ?? "server_a_preferred"));
    $pairDeleteBehavior = (string)($pair["delete_behavior"] ?? (!empty($pair["delete_propagation"] ?? false) ? "mirror_deletes" : $deleteBehavior));
    if (!in_array($pairAuthority, ["server_a_preferred", "equal_peers"], true)) {
      $pairAuthority = "server_a_preferred";
    }
    if (!in_array($pairDeleteBehavior, ["restore_missing", "mirror_deletes"], true)) {
      $pairDeleteBehavior = "restore_missing";
    }
    $syncRouteRows[] = [
      "name" => (string)($pair["name"] ?? ""),
      "local" => $pairAShare,
      "other" => $pairBShare,
      "peer_id" => (string)($pair["server_b"]["peer_id"] ?? ""),
      "authority" => $pairAuthority,
      "delete_behavior" => $pairDeleteBehavior,
      "paused" => !empty($pair["paused"]),
    ];
  }
}
$nodeRole = $config["node_role"] ?? "master";
if (!in_array($nodeRole, ["master", "managed_remote"], true)) {
  $nodeRole = "master";
}
$roleLocked = !array_key_exists("role_locked", $config) || !empty($config["role_locked"]);
$trashRoot = $config["trash_root"] ?? "/boot/config/plugins/mirror/trash";
$primaryIp = mirror_primary_ip();
$defaultSubnet = $primaryIp ? preg_replace('/\.\d+$/', ".0/24", $primaryIp) : "";
$discovery = mirror_json_file($discoveryFile, ["peers" => [], "subnet" => $defaultSubnet]);
$rawDiscoveredPeers = is_array($discovery["peers"] ?? null) ? $discovery["peers"] : [];
$peerFreshSeconds = 1800;
$discoveredPeers = array_values(array_filter($rawDiscoveredPeers, function ($peer) {
  global $peerFreshSeconds;
  $foundAt = (int)($peer["found_at"] ?? 0);
  return $foundAt > 0 && (time() - $foundAt) <= $peerFreshSeconds;
}));
$staleDiscoveredPeers = count($rawDiscoveredPeers) - count($discoveredPeers);
$discoveryScannedAt = (int)($discovery["scanned_at"] ?? 0);
$discoveryStatus = (string)($discovery["scan_status"] ?? "");
$discoveryDirectHost = (string)($discovery["direct_host"] ?? "");
$pendingInviteData = mirror_json_file($pendingInvitesFile, ["invites" => []]);
$pendingInvites = is_array($pendingInviteData["invites"] ?? null) ? $pendingInviteData["invites"] : [];
$linkedPeers = mirror_peer_list($peersFile, $peerFile);
$linkedPeer = $linkedPeers ? reset($linkedPeers) : mirror_json_file($peerFile, []);
$linkedPeerShares = is_array($linkedPeer["shares"] ?? null) ? $linkedPeer["shares"] : [];
$primaryPeerId = (string)($config["server_b"]["peer_id"] ?? ($linkedPeer["id"] ?? ""));
$remoteSharesLoaded = array_sum(array_map(function ($peer) {
  return count(is_array($peer["shares"] ?? null) ? $peer["shares"] : []);
}, $linkedPeers));
$serverName = mirror_server_name();
$mirrorState = mirror_json_file(mirror_state_path(), ["files" => [], "conflicts" => [], "pairs" => []]);
$mirrorRoutes = mirror_configured_routes($config);
$mirrorRouteSummaries = [];
foreach ($mirrorRoutes as $route) {
  $routeState = mirror_route_state($mirrorState, $route["key"]);
  $mirrorRouteSummaries[] = mirror_route_summary($route["config"], $routeState, $running);
}
$sharePageStyle = "background:radial-gradient(circle at 8% 0%,rgba(255,106,42,.08),transparent 28%),linear-gradient(145deg,#091017 0%,#10151b 40%,#070b0f 100%);border:1px solid rgba(255,255,255,.07);border-radius:8px;box-shadow:inset 0 1px 0 rgba(255,255,255,.04),0 18px 60px rgba(0,0,0,.24);box-sizing:border-box;color:#e8edf2;margin:0;padding:26px;width:100%;max-width:none;";
$shareHeaderStyle = "align-items:flex-start;display:flex;gap:18px;justify-content:space-between;margin:0 0 22px;";
$shareTitleStyle = "align-items:center;display:flex;gap:14px;min-width:0;";
$shareTopActionsStyle = "display:flex;gap:10px;justify-content:flex-end;";
$shareButtonStyle = "align-items:center;background:rgba(255,255,255,.045);border:1px solid rgba(255,255,255,.14);border-radius:6px;color:#f3f6f8;display:inline-flex;font-size:13px;font-weight:700;gap:8px;justify-content:center;letter-spacing:0;line-height:1;min-height:38px;padding:0 16px;text-decoration:none;text-transform:none;";
$sharePrimaryButtonStyle = "align-items:center;background:linear-gradient(180deg,#ff7b22 0%,#ff5f1f 100%);border:1px solid #ff7b22;border-radius:6px;box-shadow:0 10px 28px rgba(255,106,42,.24);color:#fff;display:inline-flex;font-size:13px;font-weight:800;gap:8px;justify-content:center;letter-spacing:0;line-height:1;min-height:42px;padding:0 22px;text-decoration:none;text-transform:none;";
$shareStatsStyle = "display:grid;gap:14px;grid-template-columns:repeat(4,minmax(0,1fr));margin:0 0 18px;width:100%;";
$shareStatStyle = "align-items:center;background:radial-gradient(circle at 8% 0%,rgba(255,255,255,.055),transparent 34%),linear-gradient(145deg,rgba(255,255,255,.055),rgba(255,255,255,.018));border:1px solid rgba(255,255,255,.09);border-radius:8px;box-shadow:inset 0 1px 0 rgba(255,255,255,.035);display:grid;gap:15px;grid-template-columns:52px minmax(0,1fr);min-height:104px;padding:18px 20px;";
$shareLayoutStyle = "align-items:start;display:grid;gap:16px;grid-template-columns:minmax(0,1fr) 320px;margin:0;";
$shareMainStyle = "display:grid;gap:16px;min-width:0;";
$shareCardStyle = "background:radial-gradient(circle at 0% 0%,rgba(255,255,255,.055),transparent 35%),linear-gradient(145deg,rgba(255,255,255,.052),rgba(255,255,255,.016));border:1px solid rgba(255,255,255,.09);border-radius:8px;box-shadow:inset 0 1px 0 rgba(255,255,255,.035);margin:0;padding:24px;";
$shareModeStyle = "border:1px solid rgba(255,255,255,.09);border-radius:6px;display:grid;grid-template-columns:1fr 1fr;margin:16px 0 24px;overflow:hidden;width:100%;";
$shareFormGridStyle = "display:grid;gap:22px 28px;grid-template-columns:repeat(3,minmax(0,1fr));";
$shareFieldStyle = "min-width:0;";
$shareControlStyle = "background-color:rgba(255,255,255,.055);border:1px solid rgba(255,255,255,.09);border-radius:6px;box-shadow:none;color:#f4f7f9;font-size:14px;height:42px;margin:0;max-width:none;padding:0 12px;width:100%;";
$shareHelpStyle = "color:rgba(232,237,242,.66);display:block;font-size:13px;line-height:1.35;margin-top:8px;";
$shareSaveStyle = "align-items:center;background:radial-gradient(circle at 0% 0%,rgba(255,255,255,.055),transparent 35%),linear-gradient(145deg,rgba(255,255,255,.052),rgba(255,255,255,.016));border:1px solid rgba(255,255,255,.09);border-radius:8px;box-shadow:inset 0 1px 0 rgba(255,255,255,.035);display:flex;gap:16px;justify-content:space-between;margin-top:16px;padding:16px;";
?>

<style>
.mirror-panel {
  max-width: none;
  width: 100%;
  transition: opacity 0.12s ease;
}
.mirror-panel.is-refreshing {
  opacity: 0.72;
  pointer-events: none;
}
.mirror-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 12px;
  margin: 16px 0;
}
.mirror-status-layout {
  align-items: start;
  display: grid;
  gap: 16px;
  grid-template-columns: minmax(0, 1120px) minmax(320px, 360px);
  justify-content: start;
}
.mirror-status-main {
  min-width: 0;
}
.mirror-route-sidebar {
  display: grid;
  gap: 12px;
}
.mirror-route-card {
  border: 1px solid var(--border-color, #333);
  border-radius: 6px;
  padding: 12px;
}
.mirror-route-card h3 {
  margin: 0 0 10px;
}
.mirror-route-title {
  border-bottom: 1px solid var(--border-color, #333);
  font-weight: 700;
  margin-bottom: 10px;
  padding-bottom: 7px;
}
.mirror-route-metric {
  display: grid;
  gap: 2px;
  margin: 9px 0;
}
.mirror-route-metric strong {
  font-size: 12px;
  opacity: 0.72;
  text-transform: uppercase;
}
.mirror-route-metric span {
  overflow-wrap: anywhere;
}
.mirror-route-rate {
  display: grid;
  gap: 8px;
  grid-template-columns: 1fr 1fr;
}
@media (max-width: 980px) {
  .mirror-status-layout {
    grid-template-columns: 1fr;
  }
}
.mirror-stat,
.mirror-section {
  border: 1px solid var(--border-color, #333);
  border-radius: 6px;
  padding: 12px;
}
.mirror-stat {
  box-sizing: border-box;
  height: 64px;
  overflow: hidden;
  position: relative;
}
.mirror-stat strong {
  display: block;
  font-size: 14px;
  margin-bottom: 6px;
}
.mirror-stat--version {
  padding-right: 128px;
}
.mirror-update-compact {
  margin: 0;
  position: absolute;
  right: 12px;
  top: 12px;
}
.mirror-update-compact button {
  font-size: 9px;
  line-height: 1;
  padding: 4px 7px;
}
.mirror-version-value {
  display: block;
}
.mirror-section {
  margin: 16px 0;
}
.mirror-form-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 14px;
}
