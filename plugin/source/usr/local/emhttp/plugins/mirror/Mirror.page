<script>
function openMirrorUpdateModal() {
  var modal = document.getElementById("mirror_update_modal");
  var frame = document.getElementById("mirror_update_frame");
  if (!modal || !frame) {
    return true;
  }
  modal.classList.add("is-open");
  frame.src = "about:blank";
  return true;
}

function closeMirrorUpdateModal() {
  var modal = document.getElementById("mirror_update_modal");
  var frame = document.getElementById("mirror_update_frame");
  if (modal) {
    modal.classList.remove("is-open");
  }
  if (frame) {
    frame.src = "about:blank";
  }
  refreshMirrorPanel();
}

function fetchWithTimeout(url, options, timeoutMs) {
  return new Promise(function (resolve, reject) {
    var finished = false;
    var timer = window.setTimeout(function () {
      if (finished) {
        return;
      }
      finished = true;
      reject(new Error("Request timed out."));
    }, timeoutMs);

    fetch(url, options)
      .then(function (response) {
        if (finished) {
          return;
        }
        finished = true;
        window.clearTimeout(timer);
        resolve(response);
      })
      .catch(function (error) {
        if (finished) {
          return;
        }
        finished = true;
        window.clearTimeout(timer);
        reject(error);
      });
  });
}

function showMirrorClientMessage(message) {
  var panel = document.querySelector(".mirror-panel");
  if (!panel) {
    return;
  }
  var existing = panel.querySelector(".mirror-client-message");
  if (!existing) {
    existing = document.createElement("div");
    existing.className = "mirror-client-message";
    var grid = panel.querySelector(".mirror-grid");
    if (grid && grid.parentNode) {
      grid.parentNode.insertBefore(existing, grid.nextSibling);
    } else {
      panel.insertBefore(existing, panel.firstChild);
    }
  }
  existing.textContent = message;
}

function refreshMirrorPanel(url, pushHistory) {
  var panel = document.querySelector(".mirror-panel");
  if (!panel) {
    return Promise.resolve();
  }
  var targetUrl = url || window.location.href;
  panel.classList.add("is-refreshing");
  return fetchWithTimeout(targetUrl, {
    cache: "no-store",
    credentials: "same-origin"
  }, 10000)
    .then(function (response) {
      return response.text();
    })
    .then(function (html) {
      var doc = new DOMParser().parseFromString(html, "text/html");
      var freshPanel = doc.querySelector(".mirror-panel");
      if (freshPanel) {
        panel.innerHTML = freshPanel.innerHTML;
        if (pushHistory && window.history && window.history.pushState) {
          window.history.pushState({mirrorTab: true}, "", targetUrl);
        }
        bindMirrorPage();
      }
    })
    .finally(function () {
      var currentPanel = document.querySelector(".mirror-panel");
      if (currentPanel) {
        currentPanel.classList.remove("is-refreshing");
      }
    });
}

function bindMirrorPage() {
  function hideGeneratedMirrorTitle() {
    var panel = document.querySelector(".mirror-panel");
    var candidate = panel ? panel.previousElementSibling : null;
    while (candidate && (candidate.tagName === "STYLE" || candidate.tagName === "SCRIPT")) {
      candidate = candidate.previousElementSibling;
    }
    if (candidate && candidate.textContent && candidate.textContent.trim() === "Mirror") {
      candidate.classList.add("mirror-title-strip-hidden");
    }
  }

  hideGeneratedMirrorTitle();

  document.querySelectorAll(".mirror-tabs a").forEach(function (link) {
    if (link.dataset.mirrorTabBound === "1") {
      return;
    }
    link.dataset.mirrorTabBound = "1";
    link.addEventListener("click", function (event) {
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || event.button !== 0) {
        return;
      }
      event.preventDefault();
      refreshMirrorPanel(link.href, true).catch(function () {
        window.location.href = link.href;
      });
    });
  });

  function selectedMode() {
    var selected = document.querySelector('input[name="mirror_mode"]:checked');
    return selected ? selected.value : 'local';
  }

  function syncModeVisibility() {
    var remote = selectedMode() === 'remote';
    document.querySelectorAll('.mirror-remote-only').forEach(function (node) {
      node.classList.toggle('mirror-hidden', !remote);
    });
    document.querySelectorAll('.mirror-local-only').forEach(function (node) {
      node.classList.toggle('mirror-hidden', remote);
    });
  }

  function syncSharePairEmptyState(container) {
    if (!container) {
      return;
    }
    var list = container.querySelector('[data-share-pair-list]');
    var empty = container.querySelector('[data-share-pair-empty]');
    if (empty) {
      var hasRows = !!(list && list.querySelector('[data-share-pair-row]'));
      empty.hidden = hasRows;
      empty.classList.toggle('is-hidden', hasRows);
      empty.style.setProperty('display', hasRows ? 'none' : 'block', hasRows ? 'important' : '');
    }
  }

  document.querySelectorAll('[data-share-pairs]').forEach(function (container) {
    if (container.dataset.sharePairsBound === "1") {
      return;
    }
    container.dataset.sharePairsBound = "1";
    var list = container.querySelector('[data-share-pair-list]');
    var template = container.querySelector('[data-share-pair-template]');
    var addButton = document.querySelector('[data-add-share-pair]');
    var addButtonLabel = document.querySelector('[data-add-share-pair-label]');
    var editingRow = null;
    function setControlValue(selector, value) {
      var control = document.querySelector(selector);
      if (control) {
        control.value = value || '';
        control.dispatchEvent(new Event('change', { bubbles: true }));
      }
    }
    function rowControl(row, name) {
      return row.querySelector('[name="' + name + '"]');
    }
    function setRowControl(row, name, value) {
      var control = rowControl(row, name);
      if (control) {
        control.value = value || '';
      }
    }
    function controlValue(selector) {
      var control = document.querySelector(selector);
      return control ? control.value : '';
    }
    function rowValue(row, name) {
      var control = rowControl(row, name);
      return control ? control.value : '';
    }
    function setEditingRow(row) {
      if (editingRow) {
        editingRow.removeAttribute('data-editing-route');
      }
      editingRow = row || null;
      if (editingRow) {
        editingRow.setAttribute('data-editing-route', '1');
      }
      if (addButtonLabel) {
        addButtonLabel.textContent = editingRow ? 'Update Sync Route' : 'Add Sync Route';
      }
    }
    if (addButton && list && template) {
      addButton.addEventListener('click', function () {
        var remote = selectedMode() === 'remote';
        var localShare = controlValue('#server_a_share');
        var otherShare = remote ? controlValue('#remote_share') : controlValue('#server_b_share');
        if (!localShare || !otherShare) {
          alert('Choose both sides of the sync route before adding it.');
          return;
        }
        if (remote && !controlValue('#primary_peer_id')) {
          alert('Choose the linked remote server before adding this route.');
          return;
        }
        var row = editingRow || template.cloneNode(true);
        if (!editingRow) {
          row.removeAttribute('data-share-pair-template');
          row.setAttribute('data-share-pair-row', '1');
          row.querySelectorAll('select').forEach(function (select) {
            select.selectedIndex = 0;
          });
          row.querySelectorAll('input[type="text"]').forEach(function (input) {
            input.value = '';
          });
        }
        setRowControl(row, 'additional_pair_name[]', controlValue('#route_name'));
        setRowControl(row, 'additional_pair_local[]', localShare);
        setRowControl(row, 'additional_pair_other_local[]', remote ? '' : otherShare);
        setRowControl(row, 'additional_pair_peer_id[]', remote ? controlValue('#primary_peer_id') : '');
        setRowControl(row, 'additional_pair_other_remote[]', remote ? otherShare : '');
        setRowControl(row, 'additional_pair_authority[]', controlValue('#authority'));
        setRowControl(row, 'additional_pair_delete_behavior[]', controlValue('#delete_behavior'));
        if (!editingRow) {
          setRowControl(row, 'additional_pair_paused[]', '0');
          list.appendChild(row);
        }
        setEditingRow(null);
        syncModeVisibility();
        syncSharePairEmptyState(container);
      });
    }
    container.addEventListener('click', function (event) {
      var editButton = event.target.closest('[data-edit-share-pair]');
      if (editButton) {
        var editRow = editButton.closest('[data-share-pair-row]');
        if (!editRow) {
          return;
        }
        var peerId = rowValue(editRow, 'additional_pair_peer_id[]');
        var remoteShareValue = rowValue(editRow, 'additional_pair_other_remote[]');
        var localOtherValue = rowValue(editRow, 'additional_pair_other_local[]');
        var remote = !!(peerId || remoteShareValue);
        setControlValue('input[name="mirror_mode"][value="' + (remote ? 'remote' : 'local') + '"]', remote ? 'remote' : 'local');
        var modeInput = document.querySelector('input[name="mirror_mode"][value="' + (remote ? 'remote' : 'local') + '"]');
        if (modeInput) {
          modeInput.checked = true;
        }
        setControlValue('#route_name', rowValue(editRow, 'additional_pair_name[]'));
        setControlValue('#server_a_share', rowValue(editRow, 'additional_pair_local[]'));
        setControlValue('#server_b_share', localOtherValue);
        setControlValue('#primary_peer_id', peerId);
        setControlValue('#remote_share', remoteShareValue);
        setControlValue('#authority', rowValue(editRow, 'additional_pair_authority[]'));
        setControlValue('#delete_behavior', rowValue(editRow, 'additional_pair_delete_behavior[]'));
        setEditingRow(editRow);
        syncModeVisibility();
        syncSharePairEmptyState(container);
        var editor = document.querySelector('.mirror-route-config-card');
        if (editor && editor.scrollIntoView) {
          editor.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
        return;
      }
      var removeButton = event.target.closest('[data-remove-share-pair]');
      if (!removeButton) {
        return;
      }
      var row = removeButton.closest('[data-share-pair-row]');
      if (row) {
        if (row === editingRow) {
          setEditingRow(null);
        }
        row.remove();
        syncSharePairEmptyState(container);
      }
    });
    syncSharePairEmptyState(container);
  });

  document.querySelectorAll(".mirror-panel form").forEach(function (form) {
    if (form.dataset.mirrorBound === "1" || form.target === "mirror_update_frame" || form.dataset.mirrorFullSubmit === "1") {
      return;
    }
    form.dataset.mirrorBound = "1";
    form.addEventListener("submit", function (event) {
      event.preventDefault();
      var submitter = event.submitter || null;
      var data = new FormData(form);
      var controls = form.querySelectorAll("button,input[type='submit']");
      if (submitter && submitter.name) {
        data.set(submitter.name, submitter.value);
      }
      data.set("ajax", "1");
      controls.forEach(function (control) {
        control.disabled = true;
      });
      fetchWithTimeout(form.action, {
        method: "POST",
        body: data,
        credentials: "same-origin",
        headers: {
          "X-Requested-With": "XMLHttpRequest"
        }
      }, 20000)
        .then(function () {
          return refreshMirrorPanel();
        })
        .catch(function (error) {
          controls.forEach(function (control) {
            control.disabled = false;
          });
          showMirrorClientMessage("Action did not finish in the browser: " + error.message + "\nReloading the Mirror panel to recover.");
          window.setTimeout(function () {
            window.location.reload();
          }, 800);
        });
    });
  });

  document.querySelectorAll('input[name="mirror_mode"]').forEach(function (input) {
    if (input.dataset.mirrorModeBound === "1") {
      return;
    }
    input.dataset.mirrorModeBound = "1";
    input.addEventListener('change', syncModeVisibility);
  });
  syncModeVisibility();
}

bindMirrorPage();
window.addEventListener("popstate", function () {
  refreshMirrorPanel(window.location.href, false).catch(function () {
    window.location.reload();
  });
});
<?php if ($discoveryStatus === "running"): ?>
window.setTimeout(function () {
  refreshMirrorPanel(window.location.href, false).catch(function () {
    window.location.reload();
  });
}, 3000);
<?php endif; ?>
</script>
