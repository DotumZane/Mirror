        <div class="mirror-field">
          <label for="server_a_share">Server A share</label>
          <select id="server_a_share" name="server_a_share" <?=$shares ? "" : "disabled"?>>
            <option value="">Select a share</option>
            <?php foreach ($shares as $share): ?>
              <option value="<?=mirror_value($share)?>" <?=$share === $serverAShare ? "selected" : ""?>><?=mirror_value($share)?></option>
            <?php endforeach; ?>
          </select>
          <span class="mirror-help">Source path: <?=mirror_value($config["server_a"]["root"])?></span>
