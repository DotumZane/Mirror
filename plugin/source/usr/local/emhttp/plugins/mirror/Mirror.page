        <div class="mirror-field">
          <label for="server_b_share">Server B share</label>
          <select id="server_b_share" name="server_b_share" <?=$shares ? "" : "disabled"?>>
            <option value="">Select a share</option>
            <?php foreach ($shares as $share): ?>
              <option value="<?=mirror_value($share)?>" <?=$share === $serverBShare ? "selected" : ""?>><?=mirror_value($share)?></option>
            <?php endforeach; ?>
          </select>
          <span class="mirror-help">Mirror path: <?=mirror_value($config["server_b"]["root"])?></span>
        </div>
        <div class="mirror-field">
          <label for="authority">Authority rule</label>
          <select id="authority" name="authority">
            <option value="server_a_preferred" <?=$config["authority"] === "server_a_preferred" ? "selected" : ""?>>Server A preferred</option>
            <option value="equal_peers" <?=$config["authority"] === "equal_peers" ? "selected" : ""?>>Equal peers</option>
          </select>
        </div>
        <div class="mirror-field">
          <label for="sync_interval">Daemon scan interval seconds</label>
          <input id="sync_interval" name="sync_interval" type="number" min="1" max="3600" value="<?=mirror_value($config["sync_interval"])?>">
        </div>
        <div class="mirror-check">
          <input id="delete_propagation" name="delete_propagation" type="checkbox" value="1" <?=$config["delete_propagation"] ? "checked" : ""?>>
          <label for="delete_propagation">Mirror deletes after saving trash</label>
        </div>
      </div>

      <div class="mirror-actions">
        <input type="submit" value="Save Settings" <?=$shares ? "" : "disabled"?>>
      </div>
    </form>
  </div>

  <div class="mirror-section">
    <h3>Control</h3>
    <form method="post" action="/plugins/mirror/include/action.php">
      <input type="hidden" name="csrf_token" value="<?=mirror_value($var['csrf_token'] ?? '')?>">
