#!/bin/bash
set -euo pipefail

PLUGIN="mirror"
EMHTTP_DIR="/usr/local/emhttp/plugins/${PLUGIN}"
BOOT_DIR="/boot/config/plugins/${PLUGIN}"
CONFIG="${BOOT_DIR}/config.json"
LOG="/var/log/${PLUGIN}.log"
PID="/var/run/${PLUGIN}.pid"
BASELINE_PID="/var/run/${PLUGIN}-initial-sync.pid"
CONTROL="/usr/local/sbin/mirrorctl"
PAIR_LOG="/var/log/${PLUGIN}-pairing.log"
PAIR_PID="/var/run/${PLUGIN}-pairing.pid"
PAIR_PORT="${MIRROR_PAIR_PORT:-23891}"
PHP_BIN="${PHP_BIN:-php}"
RUNNER="${EMHTTP_DIR}/scripts/mirror_runner.php"
PAIR_RUNNER="${EMHTTP_DIR}/scripts/mirror_pairing_server.php"

ensure_config() {
  mkdir -p "$BOOT_DIR"
  if [ ! -f "$CONFIG" ]; then
    cp "${EMHTTP_DIR}/default-config.json" "$CONFIG"
  fi
}

is_running() {
  [ -f "$PID" ] && kill -0 "$(cat "$PID")" 2>/dev/null
}

baseline_running() {
  [ -f "$BASELINE_PID" ] && kill -0 "$(cat "$BASELINE_PID")" 2>/dev/null
}

stop_daemon() {
  if ! is_running; then
    rm -f "$PID"
    echo "Mirror daemon already stopped"
    return 0
  fi

  daemon_pid="$(cat "$PID")"
  child_pids="$(pgrep -P "$daemon_pid" 2>/dev/null | tr '\n' ' ' || true)"
  kill "$daemon_pid" 2>/dev/null || true
  for child_pid in $child_pids; do
    kill "$child_pid" 2>/dev/null || true
  done

  for _ in 1 2 3 4 5; do
    if ! kill -0 "$daemon_pid" 2>/dev/null; then
      rm -f "$PID"
      echo "Mirror daemon stopped"
      return 0
    fi
    sleep 0.2
  done

  kill -9 "$daemon_pid" 2>/dev/null || true
  for child_pid in $child_pids; do
    kill -9 "$child_pid" 2>/dev/null || true
  done
  sleep 0.1

  if kill -0 "$daemon_pid" 2>/dev/null; then
    echo "Mirror daemon stop requested, but pid ${daemon_pid} is still running"
    return 1
  fi
  rm -f "$PID"
  echo "Mirror daemon stopped"
}

pairing_running() {
  [ -f "$PAIR_PID" ] && kill -0 "$(cat "$PAIR_PID")" 2>/dev/null
}

pairing_port_busy() {
  command -v ss >/dev/null 2>&1 && ss -ltn "sport = :${PAIR_PORT}" 2>/dev/null | grep -q ":${PAIR_PORT}"
}

pairing_port_pids() {
  {
    if command -v ss >/dev/null 2>&1; then
      ss -ltnp "sport = :${PAIR_PORT}" 2>/dev/null \
        | sed -n 's/.*pid=\([0-9][0-9]*\).*/\1/p'
    fi
    if command -v fuser >/dev/null 2>&1; then
      fuser -n tcp "$PAIR_PORT" 2>/dev/null | tr ' ' '\n' | grep -E '^[0-9]+$' || true
    fi
  } | sort -u
}

stop_pairing() {
  stopped=0
  if pairing_running; then
    kill "$(cat "$PAIR_PID")" 2>/dev/null || true
    stopped=1
  fi
  rm -f "$PAIR_PID"
  for port_pid in $(pairing_port_pids); do
    kill "$port_pid" 2>/dev/null || true
    stopped=1
  done
  sleep 0.2
  for port_pid in $(pairing_port_pids); do
    kill -9 "$port_pid" 2>/dev/null || true
    stopped=1
  done
  [ "$stopped" -eq 1 ]
}

start_pairing() {
  cd "$EMHTTP_DIR"
  nohup "$PHP_BIN" -S "0.0.0.0:${PAIR_PORT}" "$PAIR_RUNNER" >>"$PAIR_LOG" 2>&1 &
  echo "$!" > "$PAIR_PID"
  sleep 0.2
  if ! pairing_running; then
    rm -f "$PAIR_PID"
    echo "Mirror pairing responder failed to start on port $PAIR_PORT"
    tail -n 20 "$PAIR_LOG" 2>/dev/null || true
    exit 1
  fi
}

sync_interval() {
  "$PHP_BIN" "$RUNNER" interval --config "$CONFIG" 2>/dev/null || echo 10
}

interval_label() {
  if [ "${1:-10}" -eq 0 ] 2>/dev/null; then
    echo "automatic change detection"
    return
  fi
  echo "${1:-10}s interval"
}

sync_watch_paths() {
  "$PHP_BIN" -r '
    $path=$argv[1];
    $config=is_file($path) ? json_decode((string)file_get_contents($path), true) : [];
    if (!is_array($config)) {
      exit;
    }
    $paths=[];
    $add=function ($root, $type="local") use (&$paths) {
      $root=rtrim((string)$root, "/");
      $type=(string)$type;
      if ($root !== "" && $type !== "remote" && is_dir($root)) {
        $paths[$root]=true;
      }
    };
    $pairs=is_array($config["share_pairs"] ?? null) ? array_values($config["share_pairs"]) : [];
    if ($pairs) {
      foreach ($pairs as $pair) {
        if (!is_array($pair) || !empty($pair["paused"])) {
          continue;
        }
        $serverA=is_array($pair["server_a"] ?? null) ? $pair["server_a"] : [];
        $serverB=is_array($pair["server_b"] ?? null) ? $pair["server_b"] : [];
        $add($serverA["root"] ?? "", $serverA["type"] ?? "local");
        $add($serverB["root"] ?? "", $serverB["type"] ?? "local");
      }
    } else {
      foreach (["server_a", "server_b"] as $key) {
        $server=$config[$key] ?? [];
        $add($server["root"] ?? "", $server["type"] ?? "local");
      }
    }
    foreach (array_keys($paths) as $watchPath) {
      echo $watchPath . "\n";
    }
  ' "$CONFIG" 2>/dev/null
}

wait_for_change() {
  local paths=()
  mapfile -t paths < <(sync_watch_paths)
  if [ "${#paths[@]}" -eq 0 ]; then
    echo "$(timestamp) automatic detection has no local share paths to watch; retrying in 10s"
    sleep 10
    return
  fi
  if command -v inotifywait >/dev/null 2>&1; then
    echo "$(timestamp) waiting for automatic file change detection"
    if inotifywait -qq -r -e close_write,create,delete,move,attrib "${paths[@]}"; then
      return
    fi
    echo "$(timestamp) automatic detection watcher exited unexpectedly; retrying in 10s"
    sleep 10
    return
  fi
  echo "$(timestamp) automatic detection needs inotifywait; command not found, retrying in 10s"
  sleep 10
}

node_role() {
  "$PHP_BIN" -r '$path=$argv[1]; $config=is_file($path) ? json_decode((string)file_get_contents($path), true) : []; echo (is_array($config) ? ($config["node_role"] ?? "master") : "master") . "\n";' "$CONFIG" 2>/dev/null || echo master
}

timestamp() {
  date "+%Y-%m-%dT%H:%M:%S%z"
}

daemon_loop() {
  interval="${1:-10}"
  set +e +u
  set +o pipefail 2>/dev/null || true
  ensure_config
  cd "$EMHTTP_DIR"
  echo "$(timestamp) mirror daemon loop booting: interval=${interval}s php=${PHP_BIN} runner=${RUNNER} config=${CONFIG}"
  while true; do
    "$PHP_BIN" "$RUNNER" run-once --config "$CONFIG"
    code="$?"
    if [ "$code" -ne 0 ]; then
      echo "$(timestamp) sync error: run-once exited with code ${code}"
    fi
    if [ "$interval" -eq 0 ] 2>/dev/null; then
      wait_for_change
      continue
    fi
    sleep "$interval"
  done
}

case "${1:-status}" in
  daemon-loop)
    daemon_loop "${2:-10}"
    ;;
  status)
    ensure_config
    if is_running; then
      echo "Mirror daemon running with pid $(cat "$PID")"
    else
      echo "Mirror daemon stopped"
    fi
    echo "Config: $CONFIG"
    echo "Log: $LOG"
    echo "Runner: $RUNNER"
    if pairing_running; then
      echo "Pairing responder running with pid $(cat "$PAIR_PID") on port $PAIR_PORT"
    else
      echo "Pairing responder stopped"
    fi
    if baseline_running; then
      echo "Initial sync running with pid $(cat "$BASELINE_PID")"
    else
      rm -f "$BASELINE_PID"
      echo "Initial sync stopped"
    fi
    ;;
  run-once)
    ensure_config
    cd "$EMHTTP_DIR"
    "$PHP_BIN" "$RUNNER" run-once --config "$CONFIG" | tee -a "$LOG"
    ;;
  initial-sync)
    ensure_config
    if baseline_running; then
      echo "Initial sync already running with pid $(cat "$BASELINE_PID")"
      exit 0
    fi
    if [ "$(node_role)" = "managed_remote" ]; then
      echo "Initial sync skipped: this server is Managed remote and waits for the master."
      exit 0
    fi
    cd "$EMHTTP_DIR"
    echo "$(timestamp) initial sync requested: control=${CONTROL}" >>"$LOG"
    nohup sh -c '"$1" "$2" initial-sync --config "$3"; code="$?"; rm -f "$4"; exit "$code"' sh "$PHP_BIN" "$RUNNER" "$CONFIG" "$BASELINE_PID" >>"$LOG" 2>&1 &
    echo "$!" > "$BASELINE_PID"
    sleep 0.3
    if ! baseline_running; then
      rm -f "$BASELINE_PID"
      echo "Initial sync failed to launch"
      tail -n 30 "$LOG" 2>/dev/null || true
      exit 1
    fi
    echo "Initial sync started with pid $(cat "$BASELINE_PID")"
    echo "Progress is written to $LOG"
    ;;
  test-peer)
    ensure_config
    cd "$EMHTTP_DIR"
    "$PHP_BIN" "$RUNNER" test-peer --config "$CONFIG" | tee -a "$LOG"
    ;;
  resolve-conflict)
    ensure_config
    cd "$EMHTTP_DIR"
    "$PHP_BIN" "$RUNNER" resolve-conflict --config "$CONFIG" "${@:2}" | tee -a "$LOG"
    ;;
  start)
    ensure_config
    if [ "$(node_role)" = "managed_remote" ]; then
      echo "Mirror daemon start skipped: this server is Managed remote and waits for the master."
      exit 0
    fi
    if is_running; then
      echo "Mirror daemon already running with pid $(cat "$PID")"
      exit 0
    fi
    interval="$(sync_interval)"
    cd "$EMHTTP_DIR"
    echo "$(timestamp) start requested: interval=${interval}s control=${CONTROL}" >>"$LOG"
    nohup "$CONTROL" daemon-loop "$interval" >>"$LOG" 2>&1 &
    echo "$!" > "$PID"
    sleep 0.3
    if ! is_running; then
      rm -f "$PID"
      echo "Mirror daemon failed to launch"
      tail -n 20 "$LOG" 2>/dev/null || true
      exit 1
    fi
    echo "Mirror daemon started with pid $(cat "$PID") using $(interval_label "$interval")"
    ;;
  stop)
    stop_daemon
    ;;
  restart)
    ensure_config
    was_running=0
    if is_running; then
      was_running=1
      stop_daemon
    fi
    interval="$(sync_interval)"
    cd "$EMHTTP_DIR"
    echo "$(timestamp) restart requested: interval=${interval}s control=${CONTROL}" >>"$LOG"
    nohup "$CONTROL" daemon-loop "$interval" >>"$LOG" 2>&1 &
    echo "$!" > "$PID"
    sleep 0.3
    if ! is_running; then
      rm -f "$PID"
      echo "Mirror daemon failed to launch"
      tail -n 20 "$LOG" 2>/dev/null || true
      exit 1
    fi
    if [ "$was_running" -eq 1 ]; then
      echo "Mirror daemon restarted with pid $(cat "$PID") using $(interval_label "$interval")"
    else
      echo "Mirror daemon started with pid $(cat "$PID") using $(interval_label "$interval")"
    fi
    ;;
  pair-start)
    ensure_config
    if pairing_running; then
      echo "Mirror pairing responder already running with pid $(cat "$PAIR_PID") on port $PAIR_PORT"
      exit 0
    fi
    if pairing_port_busy; then
      echo "Mirror pairing responder port $PAIR_PORT is already in use by pid(s): $(pairing_port_pids | tr '\n' ' ')"
      exit 1
    fi
    start_pairing
    echo "Mirror pairing responder started with pid $(cat "$PAIR_PID") on port $PAIR_PORT"
    ;;
  pair-stop)
    if stop_pairing; then
      echo "Mirror pairing responder stopped"
    else
      echo "Mirror pairing responder already stopped"
    fi
    ;;
  pair-restart)
    stop_pairing || true
    if pairing_port_busy; then
      echo "Mirror pairing responder port $PAIR_PORT is still in use by pid(s): $(pairing_port_pids | tr '\n' ' ')"
      exit 1
    fi
    start_pairing
    echo "Mirror pairing responder restarted with pid $(cat "$PAIR_PID") on port $PAIR_PORT"
    ;;
  *)
    echo "Usage: mirrorctl {status|run-once|initial-sync|start|stop|restart|test-peer|resolve-conflict|pair-start|pair-stop|pair-restart}" >&2
    exit 2
    ;;
esac
